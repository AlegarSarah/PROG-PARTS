<Window x:Class="CybersecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="600" Width="900"
        Background="#0D0D0D"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#001F3F"
                BorderBrush="#00FFFF"
                BorderThickness="0,0,0,2">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🔒 CYBERSECURITY AWARENESS BOT 🔒"
                           FontFamily="Courier New"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#00FFFF"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Your Digital Safety Assistant"
                           FontFamily="Courier New"
                           FontSize="12"
                           Foreground="#00FF00"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Chat Area -->
        <Border Grid.Row="1"
                Background="#0A0A0A"
                Margin="10,10,10,5"
                BorderBrush="#00FFFF"
                BorderThickness="1"
                CornerRadius="5">
            <ScrollViewer x:Name="scrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          Padding="10">
                <RichTextBox x:Name="rtbChat"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             FontFamily="Courier New"
                             FontSize="13"
                             Foreground="#00FFFF"
                             Padding="5"/>
            </ScrollViewer>
        </Border>

        <!-- Input Area -->
        <Border Grid.Row="2"
                Background="#001F3F"
                Margin="10,5,10,10"
                BorderBrush="#00FFFF"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtInput"
                         Grid.Column="0"
                         Background="Transparent"
                         Foreground="White"
                         FontFamily="Courier New"
                         FontSize="13"
                         BorderThickness="0"
                         VerticalAlignment="Center"
                         Padding="10,0"
                         KeyDown="txtInput_KeyDown"
                         CaretBrush="White"/>

                <Button x:Name="btnSend"
                        Grid.Column="1"
                        Content="SEND 🔒"
                        Background="#00FFFF"
                        Foreground="#0D0D0D"
                        FontFamily="Courier New"
                        FontSize="12"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnSend_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>