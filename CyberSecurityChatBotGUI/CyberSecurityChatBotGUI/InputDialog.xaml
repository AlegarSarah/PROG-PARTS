<Window x:Class="CyberSecurityChatBotGUI.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome"
        Height="220" Width="400"
        Background="#0D0D0D"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="🔒 Welcome to Cybersecurity Awareness Bot"
                   Foreground="#00FFFF"
                   FontFamily="Courier New"
                   FontSize="13"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1"
                   Text="Please enter your name:"
                   Foreground="White"
                   FontFamily="Courier New"
                   FontSize="12"
                   Margin="0,0,0,8"/>

        <TextBox x:Name="txtName"
                 Grid.Row="2"
                 Background="#001F3F"
                 Foreground="White"
                 FontFamily="Courier New"
                 FontSize="12"
                 BorderBrush="#00FFFF"
                 BorderThickness="1"
                 Padding="8"
                 Margin="0,0,0,15"
                 KeyDown="txtName_KeyDown"/>

        <Button Grid.Row="3"
                Content="START CHATTING 🔒"
                Background="#00FFFF"
                Foreground="#0D0D0D"
                FontFamily="Courier New"
                FontSize="12"
                FontWeight="Bold"
                BorderThickness="0"
                Padding="10,8"
                Cursor="Hand"
                Click="btnStart_Click"/>
    </Grid>
</Window>